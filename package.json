{
  "name": "dsh-media-bridge",
  "version": "1.2.0",
  "description": "DeepSeek Harness plugin that routes image, audio, and video work to your own OpenAI-compatible multimodal endpoint.",
  "type": "module",
  "license": "MIT",
  "author": "gqb666",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "multimodal",
    "vision",
    "asr",
    "tts",
    "video-generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gqb666/dsh-media-bridge.git"
  },
  "homepage": "https://github.com/gqb666/dsh-media-bridge#readme",
  "bugs": {
    "url": "https://github.com/gqb666/dsh-media-bridge/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}
